# ------------------------------------------------------------------
# Doc Manager API settings. Copy this file to .env and fill it in.
# Never commit the real .env (it contains secrets).
# ------------------------------------------------------------------

# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017/doc-manager

# Port the API listens on
PORT=5000

# The address people open in the browser (the React app).
# Development: the Vite dev server. Production: your https domain.
# OAuth redirect URIs are built from it: <APP_ORIGIN>/auth/google/callback ...
APP_ORIGIN=http://localhost:5173

# production = no GraphiQL playground, quieter logs
NODE_ENV=development

# Production only: folder of the built UI (doc-manager/dist) to serve
# from this server, so UI and API share one origin.
# CLIENT_DIST=../doc-manager/dist

# Number of reverse proxies in front of the API (e.g. 1 behind nginx,
# Render, Railway, Netlify proxy). Leave empty when there is none.
# TRUST_PROXY=1

# ---------- Google sign-in (Google Cloud Console -> Credentials) ----------
# Authorized redirect URI: <APP_ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Apple sign-in (Apple Developer -> Certificates, IDs & Profiles) ----------
# Return URL: <APP_ORIGIN>/auth/apple/callback (must be https, not localhost)
# APPLE_CLIENT_ID is the Services ID (e.g. com.example.docmanager.web)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key file; use \n for line breaks on one line.
APPLE_PRIVATE_KEY=

# ---------- Email (exception reports) ----------
# Who RECEIVES them is not set here: it is the exception_mail list in the
# application_configs collection (npm run seed-config).
# Microsoft 365: smtp.office365.com, 587. Gmail: smtp.gmail.com, 587,
# with an "App password" (not your normal password).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (TLS from the start); leave empty for 587 (STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox, e.g. "Document Manager <alerts@example.com>"
MAIL_FROM=

# ---------- Scheduled health check (services/jobs/index.js) ----------
# Calls GET /app/health-check on a timer and emails exception_mail if
# the app or database is unhealthy. Default: every 480 minutes (8 hours,
# at 00:00, 08:00 and 16:00 UTC).
# Render's free plan sleeps after 15 idle minutes; to keep it awake use 14.
# KEEP_ALIVE_ENABLED=false
# KEEP_ALIVE_INTERVAL_MINUTES=480
# Address to call. Default: $RENDER_EXTERNAL_URL (set by Render itself)
# or http://localhost:PORT, followed by /app/health-check.
# KEEP_ALIVE_URL=https://your-api.onrender.com/app/health-check

# ---------- Cloudflare R2 (extended file storage) - NOT USED YET ----------
# Placeholders only: files are still stored in MongoDB GridFS, and no code
# reads these yet. Replace them with real values once the account exists:
# Cloudflare dashboard -> R2 -> create a bucket, then "Manage R2 API Tokens"
# -> create a token with Object Read & Write on that bucket.
# Keep the bucket PRIVATE: files are always served through the API routes,
# which check who is asking first.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=doc-manager-files
# S3-compatible endpoint: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
